# ── Backend ────────────────────────────────────────────────────────────────

# Neon.tech PostgreSQL connection string (get from Neon dashboard -> Connection Details)
# Must include ?sslmode=require for Neon connections.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/f1nexus?sslmode=require

# Firebase Admin SDK (download service account JSON from Firebase console)
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# LLM provider - set ONE of these. Default is Groq (free).
# To swap: change LLM_PROVIDER only. No code changes needed.
LLM_PROVIDER=groq                        # options: groq | gemini | anthropic

GROQ_API_KEY=gsk_...                     # free at console.groq.com
GROQ_MODEL=llama-3.1-70b-versatile

GEMINI_API_KEY=AIza...                   # free at aistudio.google.com
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=sk-ant-...             # paid - leave blank unless upgrading
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Telegram bot (create via @BotFather on Telegram, then /newbot)
TELEGRAM_BOT_TOKEN=...

# Web Push VAPID keys
# Generate once with: python -m py_vapid --applicationServerKey
# Copy the printed private key and public key below.
# WARNING: Never regenerate after first deployment - all existing push subscriptions will break.
VAPID_PRIVATE_KEY=...
VAPID_PUBLIC_KEY=...
VAPID_CLAIMS_EMAIL=your@email.com

# FastF1 cache directory (reuse existing ./cache if migrating from old prototype)
FASTF1_CACHE_DIR=./cache

# CORS - set to your Vercel deployment URL in production
FRONTEND_ORIGIN=http://localhost:3000

# ── Frontend (NEXT_PUBLIC_ prefix exposes to browser) ──────────────────────
# All values from your Firebase project settings (Firebase Console -> Project Settings -> General)
NEXT_PUBLIC_FIREBASE_API_KEY=...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=...
NEXT_PUBLIC_FIREBASE_APP_ID=...

# Backend URLs - update to Render deployment URL after Week 5 deployment
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Same as VAPID_PUBLIC_KEY above - exposed to browser for push subscription
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
